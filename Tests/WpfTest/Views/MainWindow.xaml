<Window x:Class="WpfTest.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:fa="http://schemas.fontawesome.com/icons/"
        xmlns:oxy="http://oxyplot.org/wpf"
        mc:Ignorable="d"
        Title="{Binding Title}"
        Width="1600" Height="960" MinWidth="1180" MinHeight="760"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}"
        FontFamily="{StaticResource AppFont}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        AllowDrop="True"
        Drop="OnWindowDrop"
        DragOver="OnWindowDragOver">

    <Window.Resources>
        <ResourceDictionary>
            <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

            <DataTemplate x:Key="FilterKindTemplate">
                <TextBlock Text="{Binding ShortTitle}" FontSize="14"/>
            </DataTemplate>

            <DataTemplate x:Key="FilterFamilyTemplate">
                <TextBlock Text="{Binding Title}" FontSize="12.5"/>
            </DataTemplate>

            <Style x:Key="PlotCard" TargetType="Border" BasedOn="{StaticResource Card}">
                <Setter Property="Padding" Value="12"/>
            </Style>

            <Style x:Key="ValueTextBox" TargetType="TextBox" BasedOn="{StaticResource ParamTextBox}">
                <Setter Property="Width" Value="104"/>
                <Setter Property="TextAlignment" Value="Right"/>
                <Setter Property="Margin" Value="10,0,0,0"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Background="{DynamicResource WindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <Grid Grid.Row="0" Margin="22,18,22,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border Width="44" Height="44" CornerRadius="12" Background="{DynamicResource AccentBrush}" VerticalAlignment="Center">
                <fa:ImageAwesome Icon="Solid_WaveSquare" Height="20" Foreground="{DynamicResource AccentForegroundBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="Лаборатория БИХ-фильтров" Style="{StaticResource HeaderTitle}"/>
                <TextBlock Text="MathCore.DSP · синтез, анализ характеристик и аудиоэксперименты"
                           Style="{StaticResource HeaderSubtitle}"/>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Style="{StaticResource Chip}">
                    <TextBlock Style="{StaticResource ChipText}" Text="{Binding FilterSummary}"/>
                </Border>
                <Border Style="{StaticResource Chip}" Background="{DynamicResource ChipAccentBackgroundBrush}" BorderBrush="{DynamicResource ChipAccentBorderBrush}">
                    <TextBlock Style="{StaticResource ChipText}" Foreground="{DynamicResource AccentBrush}"
                               Text="{Binding FilterOrder, StringFormat='Порядок: {0}'}"/>
                </Border>

                <Button Command="{Binding ToggleThemeCommand}" Style="{StaticResource ThemeToggleButton}" ToolTip="{Binding ThemeToolTip}">
                    <fa:ImageAwesome Icon="{Binding ThemeIcon}" Height="15" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Основная область -->
        <Grid Grid.Row="1" Margin="16,0,16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="376"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Панель параметров -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="16" Margin="5,5,5,5">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ScrollViewer.Resources>
                        <Style TargetType="ScrollBar" BasedOn="{StaticResource SlimScrollBar}"/>
                    </ScrollViewer.Resources>

                    <StackPanel Margin="0,0,6,0">

                        <TextBlock Text="ТИП ФИЛЬТРА" Style="{StaticResource SectionTitle}"/>
                        <ListBox ItemsSource="{Binding Kinds}"
                                 SelectedItem="{Binding SelectedKind}"
                                 Style="{StaticResource PillListBox}"
                                 ItemTemplate="{StaticResource FilterKindTemplate}"/>

                        <TextBlock Text="РЕАЛИЗАЦИЯ" Style="{StaticResource SectionTitle}" Margin="2,18,0,8"/>
                        <ComboBox ItemsSource="{Binding Families}"
                                  SelectedItem="{Binding SelectedFamily}"
                                  Style="{StaticResource ModernComboBox}"
                                  ItemTemplate="{StaticResource FilterFamilyTemplate}"/>
                        <TextBlock Text="{Binding SelectedFamily.Description}" Style="{StaticResource HintText}" Margin="2,6,0,0"/>

                        <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,16,0,16"/>

                        <TextBlock Text="ПАРАМЕТРЫ" Style="{StaticResource SectionTitle}"/>

                        <TextBlock Text="Частота дискретизации, Гц" Style="{StaticResource ParamLabel}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Slider Style="{StaticResource ModernSlider}" Minimum="1000" Maximum="96000"
                                    Value="{Binding SamplingFrequency}" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Style="{StaticResource ValueTextBox}"
                                     Text="{Binding SamplingFrequency, UpdateSourceTrigger=PropertyChanged, Delay=300}"/>
                        </Grid>
                        <TextBlock Style="{StaticResource HintText}" Margin="2,2,0,12">
                            <Run Text="Найквист:"/>
                            <Run Text="{Binding NyquistFrequency, StringFormat={}{0:F0}, Mode=OneWay}"/>
                            <Run Text="Гц"/>
                        </TextBlock>

                        <StackPanel Visibility="{Binding IsEdgeParametersVisible, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding PassLowLabel}" Style="{StaticResource ParamLabel}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Slider Style="{StaticResource ModernSlider}" Minimum="1" Maximum="{Binding NyquistFrequency}"
                                        Value="{Binding PassLowFrequency}" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Style="{StaticResource ValueTextBox}"
                                         Text="{Binding PassLowFrequency, UpdateSourceTrigger=PropertyChanged, Delay=300}"/>
                            </Grid>

                            <StackPanel Visibility="{Binding ShowPassHigh, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{Binding PassHighLabel}" Style="{StaticResource ParamLabel}" Margin="2,12,0,5"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Slider Style="{StaticResource ModernSlider}" Minimum="1" Maximum="{Binding NyquistFrequency}"
                                            Value="{Binding PassHighFrequency}" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" Style="{StaticResource ValueTextBox}"
                                             Text="{Binding PassHighFrequency, UpdateSourceTrigger=PropertyChanged, Delay=300}"/>
                                </Grid>
                            </StackPanel>

                            <StackPanel Visibility="{Binding ShowStopLow, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{Binding StopLowLabel}" Style="{StaticResource ParamLabel}" Margin="2,12,0,5"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Slider Style="{StaticResource ModernSlider}" Minimum="1" Maximum="{Binding NyquistFrequency}"
                                            Value="{Binding StopLowFrequency}" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" Style="{StaticResource ValueTextBox}"
                                             Text="{Binding StopLowFrequency, UpdateSourceTrigger=PropertyChanged, Delay=300}"/>
                                </Grid>
                            </StackPanel>

                            <StackPanel Visibility="{Binding ShowStopHigh, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{Binding StopHighLabel}" Style="{StaticResource ParamLabel}" Margin="2,12,0,5"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Slider Style="{StaticResource ModernSlider}" Minimum="1" Maximum="{Binding NyquistFrequency}"
                                            Value="{Binding StopHighFrequency}" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" Style="{StaticResource ValueTextBox}"
                                             Text="{Binding StopHighFrequency, UpdateSourceTrigger=PropertyChanged, Delay=300}"/>
                                </Grid>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Visibility="{Binding IsCutoffVisible, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Частота среза, Гц" Style="{StaticResource ParamLabel}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Slider Style="{StaticResource ModernSlider}" Minimum="1" Maximum="{Binding NyquistFrequency}"
                                        Value="{Binding CutoffFrequency}" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Style="{StaticResource ValueTextBox}"
                                         Text="{Binding CutoffFrequency, UpdateSourceTrigger=PropertyChanged, Delay=300}"/>
                            </Grid>
                        </StackPanel>

                        <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,16,0,16"
                                Visibility="{Binding IsGainParametersVisible, Converter={StaticResource BoolToVisibility}}"/>

                        <StackPanel Visibility="{Binding IsGainParametersVisible, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="ТРЕБОВАНИЯ К АЧХ" Style="{StaticResource SectionTitle}"/>

                            <TextBlock Text="Неравномерность в полосе пропускания, дБ" Style="{StaticResource ParamLabel}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Slider Style="{StaticResource ModernSlider}" Minimum="0.1" Maximum="6"
                                        Value="{Binding PassRippleDb}" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Style="{StaticResource ValueTextBox}"
                                         Text="{Binding PassRippleDb, UpdateSourceTrigger=PropertyChanged, Delay=300}"/>
                            </Grid>

                            <TextBlock Text="Подавление в полосе заграждения, дБ" Style="{StaticResource ParamLabel}" Margin="2,12,0,5"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Slider Style="{StaticResource ModernSlider}" Minimum="10" Maximum="120"
                                        Value="{Binding StopAttenuationDb}" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Style="{StaticResource ValueTextBox}"
                                         Text="{Binding StopAttenuationDb, UpdateSourceTrigger=PropertyChanged, Delay=300}"/>
                            </Grid>
                        </StackPanel>

                        <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,16,0,16"/>

                        <TextBlock Text="КОЭФФИЦИЕНТЫ" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="{Binding CoefficientsSummary}" Style="{StaticResource HintText}" Margin="2,-2,0,8"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Command="{Binding SaveCoefficientsCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,4,0">
                                <StackPanel Orientation="Horizontal">
                                    <fa:ImageAwesome Icon="Solid_Save" Height="12" VerticalAlignment="Center"/>
                                    <TextBlock Text="Сохранить" Margin="7,0,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="1" Command="{Binding LoadCoefficientsCommand}" Style="{StaticResource SecondaryButton}" Margin="4,0,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <fa:ImageAwesome Icon="Solid_FolderOpen" Height="12" VerticalAlignment="Center"/>
                                    <TextBlock Text="Загрузить" Margin="7,0,0,0"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <TextBlock Text="Выбран фильтр из файла. Загрузите коэффициенты B и A, чтобы построить его характеристики."
                                   Style="{StaticResource HintText}" Margin="2,8,0,0"
                                   Visibility="{Binding IsCustomFamily, Converter={StaticResource BoolToVisibility}}"/>

                        <Border Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,10,0,0" MaxHeight="150">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ScrollViewer.Resources>
                                    <Style TargetType="ScrollBar" BasedOn="{StaticResource SlimScrollBar}"/>
                                </ScrollViewer.Resources>
                                <TextBlock Text="{Binding CoefficientsText}" FontFamily="{StaticResource MonoFont}"
                                           FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextWrapping="Wrap"/>
                            </ScrollViewer>
                        </Border>

                        <Button Command="{Binding ResetCommand}" Style="{StaticResource SecondaryButton}" Margin="0,14,0,0">
                            <StackPanel Orientation="Horizontal">
                                <fa:ImageAwesome Icon="Solid_UndoAlt" Height="12" VerticalAlignment="Center"/>
                                <TextBlock Text="Сбросить параметры" Margin="7,0,0,0"/>
                            </StackPanel>
                        </Button>

                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Графики и аудиоэксперимент -->
            <Grid Grid.Column="1">
                <TabControl x:Name="MainTabs" Style="{StaticResource PillTabControl}" ItemContainerStyle="{StaticResource PillTabItem}">

                    <TabItem Header="Анализ характеристик">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource PlotCard}">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top" Text="АЧХ и ФЧХ" Style="{StaticResource CardTitle}" Margin="2,0,0,6"/>
                                    <oxy:PlotView Model="{Binding MagnitudePhasePlot}" Background="Transparent"/>
                                </DockPanel>
                            </Border>

                            <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource PlotCard}">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top" Text="Карта нулей и полюсов" Style="{StaticResource CardTitle}" Margin="2,0,0,6"/>
                                    <Viewbox Stretch="Uniform" Margin="0,4,0,0">
                                        <oxy:PlotView Model="{Binding PoleZeroPlot}" Width="420" Height="420" Background="Transparent"/>
                                    </Viewbox>
                                </DockPanel>
                            </Border>

                            <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource PlotCard}">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top" Text="Импульсная характеристика" Style="{StaticResource CardTitle}" Margin="2,0,0,6"/>
                                    <oxy:PlotView Model="{Binding ImpulsePlot}" Background="Transparent"/>
                                </DockPanel>
                            </Border>

                            <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource PlotCard}">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top" Text="Групповая задержка" Style="{StaticResource CardTitle}" Margin="2,0,0,6"/>
                                    <oxy:PlotView Model="{Binding GroupDelayPlot}" Background="Transparent"/>
                                </DockPanel>
                            </Border>
                        </Grid>
                    </TabItem>

                    <TabItem Header="Аудиоэксперимент">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Style="{StaticResource Card}" Padding="14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Button Command="{Binding OpenAudioCommand}" Style="{StaticResource PrimaryButton}" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <fa:ImageAwesome Icon="Solid_FileAudio" Height="13" VerticalAlignment="Center"/>
                                            <TextBlock Text="Открыть WAV/MP3" Margin="8,0,0,0"/>
                                        </StackPanel>
                                    </Button>

                                    <StackPanel Grid.Column="1" Margin="14,0,14,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding AudioFileName}" Foreground="{DynamicResource TextPrimaryBrush}"
                                                   FontSize="13.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding AudioInfo}" Style="{StaticResource HintText}" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Command="{Binding ApplyAudioFilterCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0">
                                            <StackPanel Orientation="Horizontal">
                                                <fa:ImageAwesome Icon="Solid_Filter" Height="12" VerticalAlignment="Center"/>
                                                <TextBlock Text="Фильтровать" Margin="7,0,0,0"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Command="{Binding SaveAudioCommand}" Style="{StaticResource SecondaryButton}">
                                            <StackPanel Orientation="Horizontal">
                                                <fa:ImageAwesome Icon="Solid_Save" Height="12" VerticalAlignment="Center"/>
                                                <TextBlock Text="Сохранить WAV" Margin="7,0,0,0"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Grid Grid.Row="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Style="{StaticResource Card}" Padding="12" Margin="5,0,5,5">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Orientation="Horizontal">
                                            <Button Command="{Binding PlayOriginalCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <fa:ImageAwesome Icon="Solid_Play" Height="11" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Исходный" Margin="7,0,0,0"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Command="{Binding PlayFilteredCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <fa:ImageAwesome Icon="Solid_VolumeUp" Height="11" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Результат" Margin="7,0,0,0"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Command="{Binding StopAudioCommand}" Style="{StaticResource DangerButton}">
                                                <StackPanel Orientation="Horizontal">
                                                    <fa:ImageAwesome Icon="Solid_Stop" Height="11" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Стоп" Margin="7,0,0,0"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>

                                        <TextBlock Grid.Column="1" Text="{Binding AudioStatus}" Style="{StaticResource HintText}"
                                                   VerticalAlignment="Center" Margin="16,0" TextTrimming="CharacterEllipsis"/>

                                        <TextBlock Grid.Column="2" Text="Выполняется…" Foreground="{DynamicResource WarningBrush}"
                                                   FontSize="11.5" VerticalAlignment="Center"
                                                   Visibility="{Binding IsAudioBusy, Converter={StaticResource BoolToVisibility}}"/>
                                    </Grid>
                                </Border>

                                <Border Grid.Row="1" Style="{StaticResource PlotCard}">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Top" Text="Исходный сигнал" Style="{StaticResource CardTitle}" Margin="2,0,0,6"/>
                                        <oxy:PlotView Model="{Binding AudioInputPlot}" Background="Transparent"/>
                                    </DockPanel>
                                </Border>

                                <Border Grid.Row="2" Style="{StaticResource PlotCard}">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Top" Text="Сигнал после фильтрации" Style="{StaticResource CardTitle}" Margin="2,0,0,6"/>
                                        <oxy:PlotView Model="{Binding AudioOutputPlot}" Background="Transparent"/>
                                    </DockPanel>
                                </Border>
                            </Grid>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Grid>
        </Grid>

        <!-- Строка состояния -->
        <Border Grid.Row="2" Margin="22,8,22,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Ellipse Width="7" Height="7" VerticalAlignment="Center">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="{DynamicResource SecondaryBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasError}" Value="True">
                                    <Setter Property="Fill" Value="{DynamicResource DangerBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>

                <TextBlock Grid.Column="1" Text="{Binding StatusMessage}" FontSize="11.5" Margin="8,0,0,0" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasError}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <TextBlock Style="{StaticResource ChipText}" Text="{Binding SamplingFrequency, StringFormat='fd = {0:F0} Гц'}"/>
                    <TextBlock Style="{StaticResource ChipText}" Text="{Binding NyquistFrequency, StringFormat='  ·  fN = {0:F0} Гц'}" Margin="6,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
